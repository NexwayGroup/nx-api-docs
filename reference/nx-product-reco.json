                        "type": "string"
                    },
                    "resourceId": {
                        "type": "string"
                    },
                    "resourceType": {
                        "type": "string"
                    },
                    "specific": {}
                },
                "type": "object"
            },
            "IdToIdsRecoRule": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ProductRecommendation"
                    },
                    {
                        "properties": {
                            "byParentProductIds": {
                                "additionalProperties": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                },
                                "type": "object"
                            },
                            "byProductIds": {
                                "additionalProperties": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                },
                                "type": "object"
                            }
                        },
                        "type": "object"
                    }
                ],
                "required": [
                    "eligibleStoreIds",
                    "endDate",
                    "function",
                    "levels",
                    "name",
                    "startDate",
                    "status",
                    "type"
                ]
            },
            "NormalizeException": {
                "properties": {
                    "details": {
                        "items": {
                            "$ref": "#/components/schemas/ExceptionDetail"
                        },
                        "type": "array"
                    },
                    "error": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "status": {
                        "format": "int32",
                        "type": "integer"
                    },
                    "timestamp": {
                        "format": "int64",
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "PredefinedIdsRecoRule": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ProductRecommendation"
                    },
                    {
                        "properties": {
                            "productIds": {
                                "description": "Product ids to be recommended",
                                "items": {
                                    "type": "string"
                                },
                                "type": "array",
                                "uniqueItems": true
                            }
                        },
                        "type": "object"
                    }
                ],
                "required": [
                    "eligibleStoreIds",
                    "endDate",
                    "function",
                    "levels",
                    "name",
                    "productIds",
                    "startDate",
                    "status",
                    "type"
                ]
            },
            "Price": {},
            "ProductRecommendation": {
                "discriminator": {
                    "propertyName": "function"
                },
                "properties": {
                    "catalogId": {
                        "type": "string"
                    },
                    "createDate": {
                        "deprecated": true,
                        "format": "date-time",
                        "type": "string"
                    },
                    "customerId": {
                        "type": "string"
                    },
                    "dbVersion": {
                        "format": "int64",
                        "type": "integer"
                    },
                    "discountPlan": {
                        "$ref": "#/components/schemas/DiscountPlan",
                        "description": "Discount plan"
                    },
                    "eligibleParentProductIds": {
                        "description": "Parent product ids on which recommendation can be applied",
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "uniqueItems": true
                    },
                    "eligibleProductIds": {
                        "description": "Variant product ids on which recommendation can be applied",
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "uniqueItems": true
                    },
                    "eligibleStoreIds": {
                        "description": "Store ids on which recommendation can be applied",
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "uniqueItems": true
                    },
                    "endDate": {
                        "description": "Rule end date timestamp in milliseconds",
                        "example": "1589439239780",
                        "format": "date-time",
                        "type": "string"
                    },
                    "fallbackLocale": {
                        "description": "Fallback locale",
                        "type": "string"
                    },
                    "function": {
                        "description": "Recommendations selection mode",
                        "enum": [
                            "predefinedIdsRecoRule, idToIdsRecoRule"
                        ],
                        "type": "string"
                    },
                    "id": {
                        "deprecated": true,
                        "type": "string"
                    },
                    "lastUpdateReason": {
                        "type": "string"
                    },
                    "levels": {
                        "description": "Level on which recommendation will be displayed",
                        "enum": [
                            "CART, PRODUCT, PURCHASE, INTERSTITIAL"
                        ],
                        "items": {
                            "enum": [
                                "CART",
                                "PRODUCT",
                                "PURCHASE",
                                "INTERSTITIAL"
                            ],
                            "type": "string"
                        },
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                    },
                    "localizedDesc": {
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Localized descriptions",
                        "type": "object"
                    },
                    "marketingOperationId": {
                        "description": "Prices and bundle from this marketing operation will be applied",
                        "type": "string"
                    },
                    "name": {
                        "description": "Rule name",
                        "minLength": 1,
                        "type": "string"
                    },
                    "originalId": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "sources": {
                        "description": "Restriction of recommendation to specific sources",
                        "enum": [
                            "PURCHASE, SUBSCRIPTION, MANUAL_RENEWAL, BILLING_PLAN"
                        ],
                        "items": {
                            "enum": [
                                "PURCHASE",
                                "SUBSCRIPTION",
                                "MANUAL_RENEWAL",
                                "BILLING_PLAN",
                                "UPGRADE"
                            ],
                            "type": "string"
                        },
                        "type": "array",
                        "uniqueItems": true
                    },
                    "startDate": {
                        "description": "Rule start date timestamp in milliseconds",
                        "example": "1589439239780",
                        "format": "date-time",
                        "type": "string"
                    },
                    "status": {
                        "description": "Rule status",
                        "enum": [
                            "ENABLED",
                            "DISABLED"
                        ],
                        "type": "string"
                    },
                    "type": {
                        "description": "Recommendation type",
                        "enum": [
                            "CROSS_SELL, UP_SELL, UPGRADE"
                        ],
                        "type": "string"
                    },
                    "updateDate": {
                        "deprecated": true,
                        "format": "date-time",
                        "type": "string"
                    },
                    "weight": {
                        "description": "Set rule priority when several rules apply. Bigger weight = bigger priority",
                        "format": "int32",
                        "type": "integer"
                    }
                },
                "required": [
                    "eligibleStoreIds",
                    "endDate",
                    "function",
                    "levels",
                    "name",
                    "startDate",
                    "status",
                    "type"
                ],
                "type": "object"
            },
            "ProductReport": {
                "description": "RECOMMENDED: product recommended, OVERLAPPING: same product already present in recommendation, ERROR: an error occured, MAX_SLOTS_REACHED: reached max number of recommendations",
                "properties": {
                    "explanation": {
                        "type": "string"
                    },
                    "status": {
                        "enum": [
                            "RECOMMENDED",
