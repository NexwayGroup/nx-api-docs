                                "additionalProperties": {
                                    "$ref": "#/components/schemas/RecommendationView"
                                },
                                "type": "object"
                            },
                            "type": "object"
                        },
                        "type": "object"
                    },
                    "reports": {
                        "additionalProperties": {
                            "additionalProperties": {
                                "additionalProperties": {
                                    "$ref": "#/components/schemas/RecommendationReport"
                                },
                                "type": "object"
                            },
                            "type": "object"
                        },
                        "type": "object"
                    }
                },
