    "info": {
        "description": "API to manage payment receipts and future payment documents",
        "license": {
            "name": "Nexway License Version 1.0"
        },
        "title": "Invoicing",
        "version": "1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/invoice-manager/receipts": {
            "get": {
                "operationId": "getItems",
                "parameters": [
                    {
                        "description": "Page number (zero-based)",
                        "in": "query",
                        "name": "page",
                        "schema": {
                            "default": 0,
                            "type": "integer"
                        }
                    },
                    {
                        "description": "Page size (maximum 500)",
                        "in": "query",
                        "name": "size",
                        "schema": {
                            "default": 20,
                            "type": "integer"
                        }
                    },
                    {
                        "description": "Sort order (e.g., 'createDate,desc')",
                        "in": "query",
                        "name": "sort",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SearchResultReceipt"
                                }
                            }
                        },
                        "description": "Success"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Forbidden"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Not Found"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Failure"
                    }
                },
                "summary": "Get items",
                "tags": [
                    "Receipt"
                ],
                "x-operationWeight": "300"
            },
            "post": {
                "operationId": "createItem",
                "parameters": [
                    {
                        "description": "If true, validate and return the receipt without persisting it",
                        "in": "query",
                        "name": "dryRun",
                        "schema": {
                            "default": false,
                            "type": "boolean"
                        }
                    },
                    {
                        "description": "Optional audit reason attached to the creation event",
                        "in": "query",
                        "name": "reason",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ReceiptCreateRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Receipt"
                                }
                            }
                        },
                        "description": "Receipt created"
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Invalid payload (missing customer/subsidiary/order, or order id/number)"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Forbidden"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Not Found"
                    },
                    "409": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReceiptConflictResponse"
                                }
                            }
                        },
                        "description": "A receipt already exists for this orderId, the existing receipt is returned"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Failure"
                    }
                },
                "summary": "Create a payment receipt",
                "tags": [
                    "Receipt"
                ]
            }
        },
        "/invoice-manager/receipts/{id}": {
            "get": {
                "operationId": "getItem",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "in": "query",
                        "name": "target",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Receipt"
                                }
                            }
                        },
                        "description": "Success"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Forbidden"
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Not Found"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Failure"
                    }
                },
                "summary": "Get item",
                "tags": [
                    "Receipt"
                ],
                "x-operationWeight": "200"
            }
        },
        "/invoice-manager/receipts/{id}/html": {
            "get": {
                "operationId": "getReceiptHtml",
                "parameters": [
                    {
                        "description": "Receipt number (or Mongo id)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Receipt HTML preview"
                    },
                    "401": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "403": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Forbidden"
                    },
                    "404": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Receipt not found"
                    }
                },
                "summary": "Get receipt HTML preview (debug)",
                "tags": [
                    "Receipt"
                ]
            }
        },
        "/invoice-manager/receipts/{id}/pdf": {
            "get": {
                "operationId": "getReceiptPdf",
                "parameters": [
                    {
                        "description": "Receipt number (or Mongo id)",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "If true, regenerate the PDF and overwrite the stored one",
                        "in": "query",
                        "name": "forceRegenerate",
                        "required": false,
                        "schema": {
                            "default": false,
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "format": "binary",
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Receipt PDF binary"
                    },
                    "401": {
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "403": {
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Forbidden"
                    },
                    "404": {
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Receipt not found"
                    },
                    "500": {
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "$ref": "#/components/schemas/NormalizeException"
                                }
                            }
                        },
                        "description": "Failure"
                    }
                },
                "summary": "Get receipt PDF",
                "tags": [
                    "Receipt"
                ]
            }
        }
    },
    "security": [
        {
            "Bearer": [
                "read",
                "write"
            ]
        }
    ],
    "servers": [
