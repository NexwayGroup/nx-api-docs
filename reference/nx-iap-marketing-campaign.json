        "Campaign": {
            "description": "Campaign\nSingle campaign entity.",
            "type": "object",
            "required": [
                "name",
                "startDate",
                "status"
            ],
            "properties": {
                "createDate": {
                    "description": "Entity creation time.\nValue is auto generated upon creation and read only.\nTimestamp in milliseconds.",
                    "type": "integer",
                    "format": "int64",
                    "x-go-name": "CreateDate",
                    "example": 1593683684789
                },
                "customerId": {
                    "description": "Associates entity to certain customer.",
                    "type": "string",
                    "x-go-name": "CustomerID",
                    "example": "e0436791-5866-406d-b0c8-3ba32ead438a"
                },
                "dbVersion": {
                    "description": "Concurrent operations check mechanism.\n\nUsed in update actions.\nValue is auto generated upon creation/update and read only.\n\nPrevent for any issue during concurrent update transaction done by\nparallel applications. Upon spotted dbVersion incorrectness a 412 retry\nerror is returned.\nLet's consider a scenario where two application are trying update same\nentity:\n\nApp 1:\nGET entity request at 00:00:00.000\nReceived dbVersion=0\nchange entity data\nPUT entity request at 00:00:00.009\nupdated automatically dbVersion=1\n\nApp 2:\nGET entity request with at 00:00:00.005\nReceived dbVersion=0 because update of App 1 haven't occurred yet\nchange entity data\nupdate entity at 00:00:00.014\n412 Error, because dbVersion=1 after update of App 1",
                    "type": "integer",
                    "format": "int64",
                    "x-go-name": "DbVersion",
                    "example": 0
                },
                "endDate": {
                    "description": "When the marketing campaign ends.\nTimestamp in milliseconds. Must be greater than startDate.\nWhen omitted campaign is infinite.",
                    "type": "integer",
                    "format": "uint64",
                    "x-go-name": "EndDate",
                    "example": 1596261600000
                },
                "id": {
                    "description": "Entity id.\nValue is auto generated upon creation and read only.",
                    "type": "string",
                    "x-go-name": "ID",
                    "example": "d87e0973-980a-4485-a39d-682184a8988a"
                },
                "mandatoryProducts": {
                    "description": "Products mandatory in cart (if not,  marketing campaign will be disabled)",
