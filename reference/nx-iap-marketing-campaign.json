    "swagger": "2.0",
    "info": {
        "description": "Allows define specific cart behaviour in set time frame.\n\nAvailable customization\nFilter products available in cart.\nDefine custom prices (along with price service).\n\nCampaign is triggered by URL query parameter \"mktop\" while creating the cart\ne.g. https://my-store-url/checkout/add?mktop=my_mkt_name_example&product=ef974b53-4aa1-4378-9798-97b9168bf884",
        "title": "Marketing campaign",
        "version": "1.0"
    },
    "host": "api.staging.nexway.build",
    "basePath": "/marketing-campaign",
    "paths": {
        "/campaigns": {
            "get": {
                "tags": [
                    "campaign"
                ],
                "summary": "List campaigns.",
                "operationId": "listCampaign",
                "parameters": [
                    {
                        "type": "integer",
                        "format": "int64",
                        "default": 50,
                        "x-go-name": "Size",
                        "description": "Amount of items returned per pagination page",
                        "name": "size",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int64",
                        "default": 0,
                        "x-go-name": "Page",
                        "description": "Pagination page starting from 0",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "createDate,desc",
                        "x-go-name": "Sort",
                        "description": "Sort list results\nFormat: entity_field_name,order.\nFormat entity collection: entity_sub_object_name.sub_field_name,order.",
                        "name": "sort",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "431b946a-92ea-430a-984d-c3cd65d2bb77",
                        "x-go-name": "CustomerID",
                        "description": "Filter results by customerId",
                        "name": "customerId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "x-go-name": "Name",
                        "description": "Filter results by campaign name",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "enabled",
                        "x-go-name": "Status",
                        "description": "Filter result by status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "uint64",
                        "example": "1593583200000<",
                        "x-go-name": "StartDate",
                        "description": "Search campaign which starts at specific period. In example filter\ncampaign which starts after/or at Wed Jul 01 2020 06:00:00",
                        "name": "startDate",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "uint64",
                        "example": "<1596261600000",
                        "x-go-name": "EndDate",
                        "description": "Search campaign which ends at specific period. In example filter\ncampaign which ends before/or at Wed Aug 01 2020 06:00:00",
                        "name": "endDate",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "format": "uuid4",
                        "x-go-name": "ProductsId",
                        "description": "Filter results by product or variant id",
                        "name": "products.id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "variant",
                        "x-go-name": "ProductsMatchMode",
                        "description": "Filter results by product match mode (filter mode)",
                        "name": "products.matchMode",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/responses/listCampaignSuccess"
                    },
                    "401": {
                        "$ref": "#/responses/starterUnauthorized"
                    },
                    "403": {
                        "$ref": "#/responses/starterForbidden"
                    },
                    "500": {
                        "$ref": "#/responses/starterInternalServerError"
                    }
                }
            },
            "post": {
                "tags": [
                    "campaign"
                ],
                "summary": "Creates campaign.",
                "operationId": "createCampaign",
                "parameters": [
                    {
                        "name": "Param",
                        "in": "body",
                        "schema": {
                            "type": "object",
                            "required": [
                                "name",
                                "startDate",
                                "status"
                            ],
                            "properties": {
                                "customerId": {
                                    "description": "Associates entity to certain customer.",
                                    "type": "string",
                                    "x-go-name": "CustomerID",
                                    "example": "e0436791-5866-406d-b0c8-3ba32ead438a"
                                },
                                "endDate": {
                                    "description": "When the marketing campaign ends.\nTimestamp in milliseconds. Must be greater than startDate.\nWhen omitted campaign is infinite.",
                                    "type": "integer",
                                    "format": "uint64",
                                    "x-go-name": "EndDate",
                                    "example": 1596261600000
                                },
                                "mandatoryProducts": {
                                    "description": "Products mandatory in cart (if not,  marketing campaign will be disabled)",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/CampaignProduct"
                                    },
                                    "x-go-name": "MandatoryProducts",
                                    "example": [
                                        {
                                            "id": "bda56683-4641-4d8a-af46-28a73394a2ae",
                                            "matchMode": "variant"
                                        },
                                        {
                                            "id": "7af99959-5ac4-4b15-a880-78e5f2ebc595",
                                            "matchMode": "variant"
                                        }
                                    ]
                                },
                                "name": {
                                    "description": "Marketing campaign name.\nMust be unique along with customerId (composed unique key).\nName is used in URL query parameter \"mktop\" to create campaign cart.",
                                    "type": "string",
                                    "x-go-name": "Name",
                                    "example": "my_mkt_name_example"
                                },
                                "products": {
                                    "description": "Campaign products filter.",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/CampaignProduct"
                                    },
                                    "x-go-name": "AllowedProducts",
                                    "example": [
                                        {
                                            "id": "bda56683-4641-4d8a-af46-28a73394a2ae",
                                            "matchMode": "variant"
                                        },
                                        {
                                            "id": "7af99959-5ac4-4b15-a880-78e5f2ebc595",
                                            "matchMode": "variant"
                                        }
                                    ]
                                },
                                "startDate": {
                                    "description": "When the marketing campaign starts.\nTimestamp in milliseconds.",
                                    "type": "integer",
                                    "format": "uint64",
                                    "x-go-name": "StartDate",
                                    "example": 1593583200000
                                },
                                "status": {
                                    "$ref": "#/definitions/CampaignStatus"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "$ref": "#/responses/starterSuccessCreate"
                    },
                    "400": {
                        "$ref": "#/responses/starterBadRequest"
                    },
                    "401": {
                        "$ref": "#/responses/starterUnauthorized"
                    },
                    "403": {
                        "$ref": "#/responses/starterForbidden"
                    },
                    "500": {
                        "$ref": "#/responses/starterInternalServerError"
                    }
                }
            }
        },
