                ],
                "summary": "Control Assets",
                "operationId": "controlAssets",
                "parameters": [
                    {
                        "type": "string",
                        "x-go-name": "OrderId",
                        "description": "Order id",
                        "name": "orderId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "x-go-name": "Filename",
                        "description": "File name without URL and MDAUTH e.g. software.exe",
                        "name": "filename",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/responses/starterSuccessNoContent"
                    },
                    "400": {
