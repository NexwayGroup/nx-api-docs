    "info": {
        "description": "Uploads files that will be hosted by Nexway and then accessed through public\nhttps links. Assets can be transferred as text, binary data or URL link.",
        "title": "Assets",
        "contact": {
            "url": "https://www.nexway.com"
        },
        "version": "1.0"
    },
    "host": "api.staging.nexway.build",
    "basePath": "/",
    "paths": {
        "/assets": {
            "get": {
                "description": "Returns collection of public URLs. For internal use by Nexway.",
                "tags": [
                    "asset"
                ],
                "summary": "List assets",
                "operationId": "listAssets",
                "parameters": [
                    {
                        "type": "integer",
                        "format": "int64",
                        "default": 50,
                        "x-go-name": "Size",
                        "description": "Amount of items returned per pagination page",
                        "name": "size",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int64",
                        "default": 0,
                        "x-go-name": "Page",
                        "description": "Pagination page starting from 0",
                        "name": "page",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/responses/listAssetsSuccess"
                    },
                    "400": {
                        "$ref": "#/responses/starterBadRequest"
                    },
                    "401": {
                        "$ref": "#/responses/starterUnauthorized"
                    },
                    "403": {
                        "$ref": "#/responses/starterForbidden"
                    },
                    "500": {
                        "$ref": "#/responses/starterInternalServerError"
                    }
                }
            },
            "post": {
                "description": "File is transferred using multipart/form-data\nhttps://www.w3.org/TR/html401/interact/forms.html#h-17.13.4.2 As a result\nservice will return a public https link to resource. File content is used to\ngenerate id of the asset, hence files cannot be duplicated. In such case\nasset is re-uploaded to already existing location. Only one file can be sent\nat once.\n\n# Usage and integration examples\n\n## curl\n\nTransfer file from disk\n\n\tcurl -i -X POST \\\n\t\thttps://api.staging.nexway.build/assets \\\n\t\t-H \"Authorization: Bearer ${JWT_TOKEN}\" \\\n\t\t-F file=@\"/home/user/Pictures/nexway_main.png\"\n\nTransfer using url\n\n\tcurl -i -X POST \\\n\t\thttps://api.staging.nexway.build/assets \\\n\t\t-H \"Authorization: Bearer ${JWT_TOKEN}\" \\\n\t\t-F url=\"https://www.nexway.com/wp-content/uploads/2019/08/nexway_main.png\"\n\nDefine file content type\n\n\tcurl -i -X POST \\\n\t\thttps://api.staging.nexway.build/assets \\\n\t\t-H \"Authorization: Bearer ${JWT_TOKEN}\" \\\n\t\t-F file=@\"/home//user/Documents/report.csv;type=text/csv\"\n\n## golang\n\n\t// Download file from URL\n\tfileResp, _ := http.Get(\"https://www.nexway.com/wp-content/uploads/2019/08/nexway_main.png\")\n\tdefer fileResp.Body.Close()\n\n\t// create multipart form\n\tbody := &bytes.Buffer{}\n\twriter := multipart.NewWriter(body)\n\th := make(textproto.MIMEHeader)\n\th.Set(\"Content-Disposition\", fmt.Sprintf(`form-data; name=\"%s\"; filename=\"%s\"`, \"file\", \"nexway_main.png\"))\n\th.Set(\"Content-Type\", \"image/png\")\n\tpart, _ := writer.CreatePart(h)\n\tio.Copy(part, fileResp.Body)\n\twriter.Close()\n\n\t// Execute the request\n\tr, _ := http.NewRequest(\"POST\", \"https://api.staging.nexway.build/assets\", body)\n\tr.Header.Add(\"Content-Type\", writer.FormDataContentType())\n\tr.Header.Add(\"Authorization\", \"Bearer \"+os.Getenv(\"JWT_TOKEN\"))\n\tclient := &http.Client{}\n\tresp, _ := client.Do(r)\n\n\t// Results\n\tfmt.Println(\"Headers\", resp.Header)\n\tbodyBytes, _ := ioutil.ReadAll(resp.Body)\n\tfmt.Println(\"Body\", string(bodyBytes))\n\n## java\n\n\t// Create multipart form\n\tFile file = new File(\"/home/user/Pictures/nexway_main.png\");\n\tString boundary = \"JavaMultiFormBoundary58c6x3GIcM\";\n\tHttpEntity reqEntity = MultipartEntityBuilder.create()\n\t  .setBoundary(boundary)\n\t  .addBinaryBody(\"file\", file, ContentType.IMAGE_PNG, \"nexway_main.png\")\n\t  .build();\n\n\t// Create post request with form\n\tHttpPost httpPost = new HttpPost(\"https://api.staging.nexway.build/assets\");\n\thttpPost.setHeader(\"Authorization\", \"Bearer \"+System.getenv(\"JWT_TOKEN\"));\n\thttpPost.setHeader(\"Content-Type\", \"multipart/form-data; boundary=\"+boundary);\n\thttpPost.setEntity(reqEntity);\n\n\t// Execute request\n\tCloseableHttpClient httpClient = HttpClients.createDefault();\n\tCloseableHttpResponse httpResponse = httpClient.execute(httpPost);\n\tSystem.out.println(\"Response: \" + httpResponse);\n\tSystem.out.println(\"Response Body : \" + EntityUtils.toString(httpResponse.getEntity(), \"UTF-8\"));\n\thttpClient.close();",
                "tags": [
                    "asset"
                ],
                "summary": "Upload asset",
                "operationId": "postAsset",
                "parameters": [
                    {
                        "type": "file",
                        "x-go-name": "File",
                        "description": "Upload file from hard drive",
                        "name": "file",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "x-go-name": "Url",
                        "description": "Upload by URL",
                        "name": "url",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "$ref": "#/responses/postAssetSuccess"
                    },
                    "400": {
                        "$ref": "#/responses/starterBadRequest"
                    },
                    "401": {
                        "$ref": "#/responses/starterUnauthorized"
                    },
                    "403": {
                        "$ref": "#/responses/starterForbidden"
                    },
                    "500": {
                        "$ref": "#/responses/starterInternalServerError"
                    }
                }
            },
            "delete": {
                "description": "Only Nexway employee can delete the assets.",
                "tags": [
                    "asset"
                ],
                "summary": "Delete assets",
                "operationId": "deleteAssets",
                "parameters": [
