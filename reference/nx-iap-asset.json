                        "name": "Body",
                        "in": "body",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "ids": {
                                    "description": "The request contains a list of up to 1000 keys that you want to\ndelete",
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "x-go-name": "Ids"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "$ref": "#/responses/starterSuccessNoContent"
                    },
                    "400": {
                        "$ref": "#/responses/starterBadRequest"
                    },
                    "401": {
                        "$ref": "#/responses/starterUnauthorized"
                    },
                    "403": {
                        "$ref": "#/responses/starterForbidden"
                    },
                    "500": {
                        "$ref": "#/responses/starterInternalServerError"
                    }
                }
            }
        },
        "/control/{orderId}/{filename}": {
            "get": {
                "description": "Evaluates whether product-related content file is stored in the order.",
                "tags": [
