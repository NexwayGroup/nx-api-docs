                    },
                    "endDate": {
                        "type": "string",
                        "description": "Price end date timestamp in milliseconds",
                        "format": "date-time"
                    },
                    "country": {
                        "type": "string",
                        "description": "Country code in ISO 3166-2 format",
                        "example": "FR"
                    },
                    "currency": {
                        "type": "object",
                        "properties": {
                            "currencyCode": {
                                "type": "string"
                            },
                            "defaultFractionDigits": {
                                "type": "integer",
                                "format": "int32"
                            },
                            "numericCode": {
