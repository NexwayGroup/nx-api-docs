                    },
                    {
                        "name": "msrp",
                        "in": "query",
                        "description": "Filter prices by msrp value"
                    },
                    {
                        "name": "vatIncluded",
                        "in": "query",
                        "description": "Filter prices with or without vat included"
                    },
                    {
                        "name": "startingDate",
                        "in": "query",
                        "description": "Filter by start date of the price. You can use date ranges by using < or << operator, examples: startingDate=XXXX< will return prices starting after XXXX, startingDate=<XXXX will return prices starting before XXXX, startingDate=XXXX<<YYYYY will return prices starting between XXXX and YYYY"
                    },
                    {
                        "name": "endingDate",
                        "in": "query",
                        "description": "Filter by end date of the price. You can use date ranges by using < or << operator, examples: endingDate=XXXX< will return prices ending after XXXX, endingDate=<XXXX will return prices ending before XXXX, endingDate=XXXX<<YYYYY will return prices ending between XXXX and YYYY"
                    },
                    {
                        "name": "marketingCampaignId",
                        "in": "query",
                        "description": "Filter prices by marketingCampaignId"
                    },
                    {
                        "name": "target",
                        "in": "query",
                        "description": "Return selected fields only (multiple occurrences allowed for selecting multiple fields)"
                    }
                ],
