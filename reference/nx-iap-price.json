                                "format": "int32"
                            },
                            "displayName": {
                                "type": "string"
                            },
                            "symbol": {
                                "type": "string"
                            },
                            "numericCodeAsString": {
                                "type": "string"
                            }
                        },
                        "description": "Currency code in ISO-4217 format",
                        "example": "EUR"
                    },
                    "value": {
                        "type": "number",
                        "description": "Regular price, two decimal places format",
                        "format": "double",
                        "example": 14.99
                    },
                    "vatIncluded": {
                        "type": "boolean",
                        "description": "Tax is included in price"
                    },
                    "msrp": {
                        "type": "number",
                        "description": "Recommended price, two decimal places format",
                        "format": "double",
                        "example": 39.99
                    },
                    "marketingCampaignId": {
                        "type": "string",
                        "description": "Marketing campaign Id"
                    },
                    "archived": {
                        "type": "boolean",
                        "description": "Indicator if the price was removed/archived"
                    },
                    "history": {
                        "type": "array",
                        "description": "Historical data on the price",
                        "readOnly": true,
                        "items": {
